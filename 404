<script>
// GitHub Pages 404 trick — redirect clean URLs to index.html
// /islamic/x6iz3jr → /?cat=islamic&v=x6iz3jr
(function(){
  var path  = window.location.pathname;
  var parts = path.replace(/^\//, '').split('/').filter(Boolean);
  // Only redirect if there are path segments (not a real missing file)
  if(parts.length >= 1){
    var query = '';
    if(parts[0]) query += 'cat=' + encodeURIComponent(parts[0]);
    if(parts[1]) query += '&v=' + encodeURIComponent(parts[1]);
    var newUrl = '/' + (query ? '?' + query : '') + window.location.hash;
    // Redirect after tiny delay so page renders briefly
    setTimeout(function(){ window.location.replace(newUrl); }, 800);
  }
})();
</script>
